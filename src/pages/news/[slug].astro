---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getNews } from "../../lib/news";
import type { NewsItem } from "../../data/news";

export async function getStaticPaths() {
  const news = await getNews();
  return news.map(item => ({ params: { slug: item.slug }, props: { item } }));
}

interface Props { item: NewsItem; }
const { item } = Astro.props;
const published = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric", month: "long", day: "numeric", hour: "2-digit", minute: "2-digit",
  timeZone: "Asia/Shanghai", hour12: false,
}).format(new Date(item.publishedAt));
---
<BaseLayout title={`${item.title}｜澜讯`} description={item.summary}>
  <article class="article container">
    <nav class="breadcrumb" aria-label="面包屑"><a href="/">首页</a><span>/</span><span>{item.section}</span><span>/</span><span>{item.category}</span></nav>
    <header>
      <span class="section-kicker">{item.section} · {item.category}</span>
      <h1>{item.title}</h1>
      <p class="article-deck">{item.summary}</p>
      <div class="article-meta"><span>来源：{item.source}</span><time datetime={item.publishedAt}>{published}</time></div>
    </header>
    <div class="article-body">
      {item.content.map(paragraph => <p>{paragraph}</p>)}
      <aside class="source-box">
        <strong>阅读原始来源</strong>
        <p>聚合页面只提供信息索引与简要整理，完整内容请以原始来源为准。</p>
        <a href={item.sourceUrl} target="_blank" rel="noopener noreferrer">前往 {item.source} ↗</a>
      </aside>
    </div>
    <a class="back-link" href="/">← 返回新闻首页</a>
  </article>
</BaseLayout>
