---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionBlock from "../components/SectionBlock.astro";
import { generatedAt, getNews, hasGeneratedNews } from "../lib/news";
import { sectionDefinitions, legacyCategoryMap } from "../lib/taxonomy";

const news = await getNews();
const featured = news.find(item => item.featured) ?? news[0];
const updatedAt = generatedAt
  ? new Intl.DateTimeFormat("zh-CN", {
      month: "2-digit", day: "2-digit", hour: "2-digit", minute: "2-digit",
      timeZone: "Asia/Shanghai", hour12: false,
    }).format(new Date(generatedAt))
  : "尚未接入";
---
<BaseLayout>
  <section class="ticker"><div class="container"><strong>即时</strong><span>{hasGeneratedNews ? `VPS 公开来源已接入 · 热门榜与信息流更新时间 ${updatedAt} · 请点击原文核对` : "新闻数据接口尚未启用，目前展示安全的版面演示内容。"}</span></div></section>

  <div class="container page-shell">
    {featured && (
      <section class="lead-grid" aria-labelledby="top-story">
        <article class="lead-story">
          <div class="eyebrow">今日焦点 · {featured.section} / {featured.category}</div>
          <h1 id="top-story"><a href={`/news/${featured.slug}/`}>{featured.title}</a></h1>
          <p>{featured.summary}</p>
          <div class="lead-source">来源：{featured.source}</div>
        </article>
        <aside class="briefing">
          <span class="section-kicker">编辑台</span>
          <h2>不追逐噪音，只整理重要信息</h2>
          <p>保留原文链接、明确发布时间，并将事实与摘要分开呈现。</p>
          <dl><div><dt>数据状态</dt><dd>{hasGeneratedNews ? "VPS 公开来源" : "演示模式"}</dd></div><div><dt>最近更新</dt><dd>{updatedAt}</dd></div></dl>
        </aside>
      </section>
    )}

    <section class="section-overview" aria-label="三大主栏目">
      {sectionDefinitions.map(definition => <SectionBlock definition={definition} items={news} />)}
    </section>

    <section class="all-news-callout" aria-labelledby="all-news-title">
      <div><span class="section-kicker">继续阅读</span><h2 id="all-news-title">全部最新</h2><p>按时间浏览全部内容，先选主栏目，再选对应子栏目。</p></div>
      <a class="section-more" href="/news/">打开全部新闻 →</a>
    </section>
  </div>
  <script is:inline define:vars={{ legacyCategoryMap }}>
    const oldCategory = new URLSearchParams(location.search).get("category");
    const target = oldCategory && legacyCategoryMap[oldCategory];
    if (target) location.replace(`/category/${target}/`);
  </script>
</BaseLayout>
