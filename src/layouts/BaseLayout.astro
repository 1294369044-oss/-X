---
import "../styles/global.css";
import "../styles/navigation.css";
import generatedNews from "../data/generated-news.json";
import { sectionDefinitions, categoryPath } from "../lib/taxonomy";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "澜讯｜看清正在发生的事",
  description = "中文新闻聚合与脉络整理，保留来源，拒绝信息噪音。",
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const hasGeneratedNews = generatedNews.items.length > 0;
const today = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "long",
  day: "numeric",
  weekday: "long",
  timeZone: "Asia/Shanghai",
}).format(new Date());
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#101820" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到主要内容</a>
    <header class="site-header">
      <div class="utility container">
        <span>{today}</span>
        <span class="demo-badge">{hasGeneratedNews ? "自动聚合 · 请核对原文" : "当前为演示数据"}</span>
      </div>
      <div class="brand-row container">
        <a class="brand" href="/" aria-label="澜讯首页">
          <span class="brand-mark">澜</span>
          <span><strong>澜讯</strong><small>NEWSROOM X</small></span>
        </a>
        <p>看清正在发生的事</p>
      </div>
      <button class="menu-toggle" id="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav">
        <span aria-hidden="true">☰</span><span>菜单</span>
      </button>
      <nav class="nav-wrap" id="main-nav" aria-label="主导航">
        <div class="nav container">
          <a class="nav-home" href="/">首页</a>
          {sectionDefinitions.map(section => (
            <details class="nav-group">
              <summary><span>{section.name}</span><span class="nav-chevron" aria-hidden="true">⌄</span></summary>
              <div class="nav-menu">
                <a class="nav-overview" href={`/section/${section.slug}/`}>栏目总览</a>
                {section.slug === "tech" && <a href="/ai/">AI 情报</a>}
                {section.categories.map(category => <a href={categoryPath(category.name)}>{category.name}</a>)}
              </div>
            </details>
          ))}
          <a class="nav-about" href="/about/">关于</a>
        </div>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="container footer-grid">
        <div><strong>澜讯</strong><p>聚合公开信息，保留原始来源。</p></div>
        <div><p>内容版权归原作者及来源机构所有。</p><p>{hasGeneratedNews ? "自动聚合内容未经人工逐条核验，请以原文为准。" : "本站演示数据不构成事实报道或专业建议。"}</p></div>
      </div>
    </footer>
  </body>
  <script>
    const toggle = document.querySelector<HTMLButtonElement>("#menu-toggle");
    const nav = document.querySelector<HTMLElement>("#main-nav");
    toggle?.addEventListener("click", () => {
      const open = nav?.classList.toggle("is-open") ?? false;
      toggle.setAttribute("aria-expanded", String(open));
    });
    nav?.querySelectorAll("a").forEach(link => link.addEventListener("click", () => {
      if (window.matchMedia("(max-width: 850px)").matches) {
        nav.classList.remove("is-open");
        toggle?.setAttribute("aria-expanded", "false");
      }
    }));
  </script>
</html>
