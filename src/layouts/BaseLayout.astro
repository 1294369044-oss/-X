---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "澜讯｜看清正在发生的事",
  description = "中文新闻聚合与脉络整理，保留来源，拒绝信息噪音。",
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const today = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "long",
  day: "numeric",
  weekday: "long",
  timeZone: "Asia/Shanghai",
}).format(new Date());
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#101820" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到主要内容</a>
    <header class="site-header">
      <div class="utility container">
        <span>{today}</span>
        <span class="demo-badge">当前为演示数据</span>
      </div>
      <div class="brand-row container">
        <a class="brand" href="/" aria-label="澜讯首页">
          <span class="brand-mark">澜</span>
          <span><strong>澜讯</strong><small>NEWSROOM X</small></span>
        </a>
        <p>看清正在发生的事</p>
      </div>
      <nav class="nav-wrap" aria-label="主导航">
        <div class="nav container">
          <a href="/">首页</a>
          <a href="/?category=要闻">要闻</a>
          <a href="/?category=国际">国际</a>
          <a href="/?category=科技">科技</a>
          <a href="/?category=财经">财经</a>
          <a href="/?category=文化">文化</a>
          <a href="/?category=生活">生活</a>
          <a href="/about/">关于</a>
        </div>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="container footer-grid">
        <div><strong>澜讯</strong><p>聚合公开信息，保留原始来源。</p></div>
        <div><p>内容版权归原作者及来源机构所有。</p><p>本站演示数据不构成事实报道或专业建议。</p></div>
      </div>
    </footer>
  </body>
</html>
